# Hypr monitors symlink (host-specific, managed at runtime)
hypr/.config/hypr/config/monitors.conf
hypr/.config/hypr/old/config/monitors.conf
# Secrets directory
.local_secrets/
home/.gitconfig
nushell/.config/nushell/history.txt

# Nix build results
result
result-*
# Agent worktrees and local settings
/.claude/worktrees
/.claude/settings.local.json
# Wallpaper colours, generated by Mantle's lib/app_colours.lua
mantle/.config/mantle/config/wallpaper_colours.lua
hypr/.config/hypr/config/wallpaper_colours.lua
kitty/.config/kitty/mantle-colours.conf
niri/.config/niri/wallpaper-colours.kdl
fish/.config/fish/themes/mantle.theme
zed/.config/zed/themes/mantle.json
btop/.config/btop/themes/mantle.theme
# Claude Code binary symlink, managed by its installer
bin/.local/bin/claude
