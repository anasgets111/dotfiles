#!/usr/bin/env bash
set -euo pipefail

((EUID == 0)) || exec sudo -- "$0" "$@"

install_file() {
    local mode=$1 path=$2
    printf '  Installing %-50s ' "$path"
    install -Dm "$mode" /dev/stdin "$path"
    printf 'done\n'
}

printf '\n== Reboot-required notifications ==\n\n'

install_file 755 /usr/local/bin/notify-reboot-required <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

components=("$@")
if ((${#components[@]} == 0)) && [[ ! -t 0 ]]; then
  mapfile -t components
fi

for i in "${!components[@]}"; do
  [[ ${components[i]} == usr/lib/modules/*/vmlinuz ]] && components[i]=kernel
done

if ((${#components[@]})); then
  title="Restart recommended"
  printf -v items ' • <code>%s</code><br/>' "${components[@]}"
  body="<b>Restart to finish applying these updates:</b><br/>${items}<br/><i>Restart whenever convenient.</i>"
  console="Restart recommended after updating: ${components[*]}"
else
  title="Restart recommended"
  body="System components were updated. Restart when convenient to finish applying them."
  console="Restart recommended after system updates."
fi

printf 'Warning: %s\n' "$console" >&2

while read -r _ user _; do
  busctl --machine="$user@.host" --user call \
    org.freedesktop.Notifications /org/freedesktop/Notifications \
    org.freedesktop.Notifications Notify susssasa{sv}i \
    "System Update" 0 system-reboot "$title" "$body" 0 \
    3 urgency y 2 \
    category s "device.software-update" \
    resident b true \
    0 &>/dev/null || true
done < <(loginctl list-users --no-legend)
SCRIPT

install_file 644 /etc/pacman.d/hooks/90-reboot-required.hook <<'HOOK'
[Trigger]
Operation = Upgrade
Type = Package
Target = amd-ucode
Target = intel-ucode
Target = linux-firmware*
Target = nvidia
Target = nvidia-open
Target = nvidia-dkms
Target = nvidia-open-dkms
Target = nvidia-lts
Target = nvidia-open-lts

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Checking if reboot is required...
When = PostTransaction
NeedsTargets
Exec = /usr/local/bin/notify-reboot-required
HOOK

printf '\nInstalled reboot-required notification hook.\n\n'
