#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="/mnt/Work/Home_backup"
MOUNT_POINT="$(dirname "$BACKUP_DIR")"

# Check if mount exists to prevent filling root partition
if ! mountpoint -q "$MOUNT_POINT"; then
    echo "Error: Backup drive not mounted at $MOUNT_POINT" >&2
    exit 1
fi

EXCLUDES=(
    # Temp/cache files
    '*.tmp' '*.log' '*.bak'
    '*.swp' '*.swo' '*~' '.DS_Store'

    # Dependencies
    'vendor' 'node_modules'

    # Build artifacts
    'target' 'build' 'dist' 'out'

    # Version control
    '.git' '.svn' '.hg'

    # Python
    '__pycache__' '*.pyc' '*.pyo' '.venv' '.tox'

    # IDE/Editor
    '.idea' '.gradle'

    # Misc
    '.next' '.nuxt' 'coverage' '.parcel-cache'

    # Electron/Chromium volatile caches (safe to regenerate)
    # Native installs (~/.config/*)
    '.config/**/Cache/'
    '.config/**/Code Cache/'
    '.config/**/GPUCache/'
    '.config/**/GrShaderCache/'
    '.config/**/ShaderCache/'
    '.config/**/DawnCache/'
    '.config/**/DawnGraphiteCache/'
    '.config/**/DawnWebGPUCache/'
    '.config/**/GraphiteDawnCache/'
    '.config/**/Crashpad/'
    '.config/**/blob_storage/'
    '.config/**/BrowserMetrics/'
    '.config/**/Reporting and NEL/'
    '.config/**/OptimizationHints/'
    '.config/**/VideoDecodeStats/'
    '.config/**/Service Worker/CacheStorage/'
    '.config/**/Service Worker/ScriptCache/'
    '.config/zen/**/storage/default/*/cache/'
    '.config/zen/**/storage/temporary/'

    # Chromium forks (Antigravity/VS Code/etc.) additional volatile dirs
    '.config/**/CachedData/'
    '.config/**/CachedExtensionVSIXs/'

    # Cache directories & installed toolchains/runtimes
    '.cache'
    '.local/share/Trash'
    '.npm'
    '.nv'
    '.bun/install/cache'
    '.local/share/cargo/registry'
    '.local/share/cargo/git'
    '.local/share/containers'
    '.local/share/fnm'
    '.local/share/nvim'
    '.local/share/Steam'
    '.local/share/zed'
    '_cacache'

    # Installed CLI/desktop runtime state not backed up
    '.bash_history'
    '.claude'
    '.claude.json*'
    '.config/autostart'
    '.config/btop'
    '.config/cava'
    '.config/menus'
    '.config/nautilus'
    '.config/pulse'
    '.config/systemd'
    '.config/user-dirs.dirs'
    '.config/user-dirs.locale'
    '.config/wireplumber'
    '.local/share/applications'
    '.local/share/fish'
    '.local/share/gvfs-metadata'
    '.local/share/icons'
    '.local/share/kpeoplevcard'
    '.local/share/mime'
    '.local/share/nautilus'
    '.local/share/org.gnome.TextEditor'
    '.local/share/papers'
    '.local/share/recently-used.xbel'
    '.local/state/fnm_multishells'
    '.local/state/lesshst'
    '.local/state/mpv'
    '.local/state/nvim'
    '.local/state/wireplumber'

    # More cache patterns (within apps - keeps sessions/logins/settings)
    'CachedConfigurations'
    'CachedProfilesData'

    # User content folders
    '/Desktop'
    '/Documents'
    '/Music'
    '/Pictures'
    '/Public'
    '/Templates'
    '/Videos'

    # Stow-managed files (home module)
    '.bashrc'
    '.gitconfig'
    '.profile'
    '.stowrc'

    # Stow-managed files (config module)
    '.config/electron-flags.conf'
    '.config/fastfetchTheme.jsonc'
    '.config/xdg-terminals.list'

    # Hex runtime state (keeps settings, onboarding and models)
    '.local/share/hex/onboarding-step'
    '.local/share/hex/gpu-failures.json'
    '.local/share/hex/history.json'
    '.local/share/hex/local-api.json'
    '.local/share/hex/update-bucket'
    '.local/share/hex/logs'
    '.local/share/hex/updates'
    '.local/share/hex/service.sock'
    '.local/share/hex/*.lock'

    # Generated by Mantle from the wallpaper (lib/app_colours.lua)
    '.config/gtk-4.0'
    '.config/starship.toml'
    '.local/share/color-schemes'
    '.local/share/gtksourceview-5'
    '.local/share/themes'

    # Stow-managed directories (other modules - symlinked entirely)
    '.config/alacritty'
    '.config/containers'
    '.config/fish'
    '.config/foot'
    '.config/ghostty'
    '.config/hypr'
    '.config/kitty'
    '.config/mantle'
    '.config/mpv'
    '.config/niri'
    '.config/nushell'
    '.config/nvim'
    '.config/wezterm'
    '.config/xdg-desktop-portal'
    '.config/zed'
    '.local/bin'

    # Additional app runtime caches
    'node-versions'
    'Shared Dictionary'
    'audio_cache'
    'media_cache'
)

RSYNC_ARGS=(-avh "${EXCLUDES[@]/#/--exclude=}")

if [[ "${1:-}" == "--restore" || "${1:-}" == "-r" ]]; then
    echo "Restoring from $BACKUP_DIR to $HOME..."
    rsync "${RSYNC_ARGS[@]}" "$BACKUP_DIR/" "$HOME/"
else
    echo "Backing up $HOME to $BACKUP_DIR..."
    mkdir -p "$BACKUP_DIR"
    rsync "${RSYNC_ARGS[@]}" --delete --delete-excluded "$HOME/" "$BACKUP_DIR/"
fi
