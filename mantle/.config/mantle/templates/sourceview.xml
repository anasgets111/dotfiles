<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="mantle" _name="Mantle" version="1.0">
  <author>Generated by Mantle (lib/app_colours.lua) from templates/sourceview.xml, after Catppuccin's scheme</author>
  <_description>Wallpaper colours for GtkSourceView 5 and GNOME Text Editor</_description>

  <!-- Palette colors -->
  <color name="rosewater" value="{{primary}}"/>
  <color name="flamingo"  value="{{tertiary}}"/>
  <color name="pink"      value="{{tertiary}}"/>
  <color name="mauve"     value="{{primary}}"/>
  <color name="red"       value="{{red}}"/>
  <color name="maroon"    value="{{red}}"/>
  <color name="peach"     value="{{peach}}"/>
  <color name="yellow"    value="{{yellow}}"/>
  <color name="green"     value="{{green}}"/>
  <color name="teal"      value="{{teal}}"/>
  <color name="sky"       value="{{teal}}"/>
  <color name="sapphire"  value="{{blue}}"/>
  <color name="blue"      value="{{blue}}"/>
  <color name="lavender"  value="{{secondary}}"/>
  <color name="text"      value="{{on_surface}}"/>
  <color name="subtext1"  value="{{on_surface_variant}}"/>
  <color name="subtext0"  value="{{on_surface_variant}}"/>
  <color name="overlay2"  value="{{on_surface_variant}}"/>
  <color name="overlay1"  value="{{outline}}"/>
  <color name="overlay0"  value="{{outline}}"/>
  <color name="surface2"  value="{{outline_variant}}"/>
  <color name="surface1"  value="{{surface_container_highest}}"/>
  <color name="surface0"  value="{{surface_container_high}}"/>
  <color name="base"      value="{{surface}}"/>
  <color name="mantle"    value="{{surface_container_low}}"/>
  <color name="selection" value="{{tint_primary}}"/>
  <color name="crust"     value="{{chrome}}"/>

  <!-- Base editor colors -->
  <style name="text"                     foreground="text" background="base"/>
  <style name="selection"                foreground="text" background="selection"/>
  <style name="cursor"                   foreground="rosewater"/>
  <style name="current-line"             background="surface0"/>
  <style name="line-numbers"             foreground="overlay0" background="base"/>
  <style name="current-line-number"      foreground="mauve" background="surface0" bold="true"/>
  <style name="draw-spaces"              foreground="surface1"/>
  <style name="background-pattern"       background="surface0"/>

  <!-- Code syntax elements -->
  <style name="def:comment"              foreground="overlay0" italic="true"/>
  <style name="def:string"               foreground="green"/>
  <style name="def:character"            foreground="green"/>
  <style name="def:special-char"         foreground="pink"/>
  <style name="def:keyword"              foreground="mauve" bold="true"/>
  <style name="def:operator"             foreground="sky"/>
  <style name="def:function"             foreground="blue" bold="true"/>
  <style name="def:type"                 foreground="yellow"/>
  <style name="def:identifier"           foreground="text"/>
  <style name="def:preprocessor"         foreground="pink"/>
  <style name="def:statement"            foreground="mauve"/>
  <style name="def:boolean"              foreground="peach"/>
  <style name="def:number"               foreground="peach"/>
  <style name="def:decimal"              foreground="peach"/>
  <style name="def:floating-point"       foreground="peach"/>
  <style name="def:constant"             foreground="peach"/>
  <style name="def:special-constant"     foreground="peach"/>
  <style name="def:error"                foreground="red" bold="true"/>
  <style name="def:note"                 foreground="yellow" bold="true"/>
  <style name="def:underlined"           underline="true"/>
</style-scheme>
